# VPS production defaults. Secrets belong in
# /home/morrow/.config/morrows/service.env and must not be committed.
MORROWS_DATABASE_URL=sqlite:///srv/morrow/workspaces/morrows/data/morrows.db
MORROWS_BIND=127.0.0.1:8787
MORROWS_WEB_DIR=/srv/morrow/workspaces/morrows/web/dist
MORROWS_LAUNCH_DIR=/srv/morrow/workspaces/morrows/data/launches
MORROWS_SESSION_RUNTIME_DIR=/srv/morrow/workspaces/morrows/data/session-runtimes
MORROWS_REQUIRE_AGENT_AUTH=1
MORROWS_REQUIRE_OPERATOR_AUTH=1
MORROWS_LSM_CONTROL_URL=http://127.0.0.1:8766
MORROWS_MCP_URL=https://mcp.xycdev.com/morrows
# MORROWS_LSM_CONTROL_KEY=<copy from the VPS Local Shell MCP control API key>
