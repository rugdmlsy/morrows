# VPS production defaults. Secrets belong in
# /home/morrow/.config/morrows/service.env and must not be committed.
MORROWS_DATABASE_URL=sqlite:///srv/morrow/workspaces/morrows/data/morrows.db
MORROWS_BIND=127.0.0.1:8787
MORROWS_WEB_DIR=/srv/morrow/workspaces/morrows/web/dist
MORROWS_LAUNCH_DIR=/srv/morrow/workspaces/morrows/data/launches
MORROWS_SESSION_RUNTIME_DIR=/srv/morrow/workspaces/morrows/data/session-runtimes
MORROWS_REQUIRE_AGENT_AUTH=1
MORROWS_REQUIRE_OPERATOR_AUTH=1
MORROWS_RUNTIME_CONTROL_URL=http://127.0.0.1:8790
MORROWS_RUNTIME_PROXY_URL=http://127.0.0.1:8790
MORROWS_RUNTIME_MCP_URL=https://mcp.xycdev.com/morrows/ui/runtime/mcp
MORROWS_RUNTIME_SUBJECT=morrows-runtime
# Public /morrows calls use validated LSM OAuth client_id provenance.
# Morrows creates/resolves the technical AgentInstance automatically.
MORROWS_MCP_URL=https://mcp.xycdev.com/morrows
MORROWS_AGENT_MCP_URL=https://mcp.xycdev.com/morrows/ui/agent-mcp
# scripts/deploy-vps.sh creates /home/morrow/.config/morrows/runtime.env
# with a private MORROWS_RUNTIME_CONTROL_KEY. Standalone LSM remains a separate
# OAuth/administration service and is not the Morrows execution runtime.
