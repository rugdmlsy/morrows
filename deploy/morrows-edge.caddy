# Managed by Morrows. Public Morrows authentication and MCP go directly to the
# control plane; neither standalone LSM nor morrow-runtime is on that path.
:8765 {
	bind 127.0.0.1

	@morrows_browser_root {
		method GET
		path /morrows /morrows/
		header Accept *text/html*
	}
	handle @morrows_browser_root {
		redir * /morrows/ui/ 302
	}

	@morrows_metadata path /.well-known/oauth-protected-resource/morrows /.well-known/oauth-authorization-server/morrows/auth
	handle @morrows_metadata {
		reverse_proxy 127.0.0.1:8787
	}

	@morrows_auth path /morrows/auth /morrows/auth/*
	handle @morrows_auth {
		reverse_proxy 127.0.0.1:8787
	}

	@morrows_mcp path /morrows /morrows/
	handle @morrows_mcp {
		reverse_proxy 127.0.0.1:8787
	}

	@morrows_health path /morrows/health
	handle @morrows_health {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:8787
	}

	handle /morrows/api/* {
		uri strip_prefix /morrows
		reverse_proxy 127.0.0.1:8787
	}

	# Do not publish alternate MCP surfaces through the static UI mount.
	@retired_mcp path /morrows/ui/agent-mcp /morrows/ui/agent-mcp/* /morrows/ui/mcp /morrows/ui/mcp/* /morrows/ui/morrows /morrows/ui/morrows/*
	handle @retired_mcp {
		respond "Use /morrows with Morrows OAuth" 410
	}
	@morrows_ui_root path /morrows/ui
	handle @morrows_ui_root {
		redir * /morrows/ui/ 308
	}
	handle /morrows/ui/* {
		uri strip_prefix /morrows/ui
		reverse_proxy 127.0.0.1:8787
	}
	handle /morrows/* {
		respond "Not found" 404
	}

	# Standalone LSM owns only the remaining root surfaces.
	handle {
		reverse_proxy 127.0.0.1:8766
	}
}
